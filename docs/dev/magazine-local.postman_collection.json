{
  "info": {
    "name": "HASHI 매거진 로컬 테스트",
    "description": "매거진(#69) 엔드포인트 로컬 테스트 컬렉션.\n\n사전 조건\n1. 로컬 MySQL(hashi_local)·Redis 기동 + `./gradlew bootRun`(local 프로필)\n2. adminToken/userToken 모두 로컬 JWT 시크릿으로 서명한 30일 토큰이 기본값으로 들어 있어 바로 사용 가능.\n3. 실제 로그인 플로우를 태우고 싶으면 '어드민 로그인' 요청을 실행 — 응답의 30분짜리 토큰이 adminToken을 덮어쓴다(만료되면 다시 로그인하거나 기본값 복원).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminToken", "value": "eyJhbGciOiJIUzI1NiJ9.eyJqdGkiOiIxZGMzOTMzZS1lZTVmLTQzMWEtYTUyZS1hZDIxNzczZDgwNjMiLCJzdWIiOiIxIiwicm9sZSI6IlJPTEVfQURNSU4iLCJ0eXBlIjoiYWNjZXNzIiwiaWF0IjoxNzgzNjIxMzkyLCJleHAiOjE3ODYyMTMzOTJ9.N4K9oxuBtlvz7QLy4dBtA51bDZ7x85UNkSJ1FsxHCUs" },
    { "key": "userToken", "value": "eyJhbGciOiJIUzI1NiJ9.eyJqdGkiOiIzMjA1MmIwMC03ZDZlLTQ5NmEtOGUyNi1jNGRmMTliZDlmYTgiLCJzdWIiOiIxIiwicm9sZSI6IlJPTEVfVVNFUiIsInR5cGUiOiJhY2Nlc3MiLCJpYXQiOjE3ODM2MTk0NTAsImV4cCI6MTc4NjIxMTQ1MH0.mBzAU0qaI_GhxigRvA_kaCPsS62ebrbDgU_L1HTSKLA" },
    { "key": "magazineId", "value": "" }
  ],
  "item": [
    {
      "name": "어드민 로그인 (adminToken 자동 저장)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const auth = pm.response.headers.get('Authorization');",
              "if (auth) {",
              "    pm.collectionVariables.set('adminToken', auth.replace('Bearer ', ''));",
              "    console.log('adminToken 저장 완료');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/v1/auth/admin/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "admin", "login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"loginId\": \"admin\",\n    \"password\": \"hashi-local-admin!\"\n}"
        }
      }
    },
    {
      "name": "admin - 매거진 업로드 (magazineId 자동 저장)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.data && json.data.magazineId) {",
              "    pm.collectionVariables.set('magazineId', json.data.magazineId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/v1/admin/magazines", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "magazines"] },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"도쿄 스시 오마카세 특집\",\n    \"bannerKey\": \"magazine/banners/sample-tokyo-sushi.jpg\",\n    \"instagramRedirectUrl\": \"https://www.instagram.com/p/sample-tokyo-sushi/\"\n}"
        }
      }
    },
    {
      "name": "admin - 매거진 수정",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/v1/admin/magazines/{{magazineId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "magazines", "{{magazineId}}"] },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"도쿄 스시 오마카세 특집 (수정)\"\n}"
        },
        "description": "부분 수정(PATCH) — 보낸 필드만 변경. bannerKey / instagramRedirectUrl도 같은 방식으로 개별 수정 가능."
      }
    },
    {
      "name": "admin - 매거진 삭제",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/v1/admin/magazines/{{magazineId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "magazines", "{{magazineId}}"] }
      }
    },
    {
      "name": "매거진 배너 GET (최신 5개)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/v1/magazines/banners", "host": ["{{baseUrl}}"], "path": ["api", "v1", "magazines", "banners"] }
      }
    },
    {
      "name": "매거진 리스트 GET (최신순 커서)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/v1/magazines?size=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "magazines"],
          "query": [
            { "key": "size", "value": "10", "description": "1~50, 기본 10" },
            { "key": "cursor", "value": "", "description": "이전 응답의 nextCursor를 그대로 전달", "disabled": true }
          ]
        }
      }
    }
  ]
}
