{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "hashi-map-maintenance",
      "folder": "Hashi",
      "interval": "1m",
      "rules": [
        {
          "uid": "hashi-map-access-denied",
          "title": "Hashi map access_denied",
          "condition": "B",
          "for": "0s",
          "noDataState": "NoData",
          "execErrState": "Error",
          "isPaused": true,
          "labels": {
            "service": "hashi-map",
            "environment": "REPLACE_WITH_ENVIRONMENT",
            "reason": "access_denied",
            "severity": "critical"
          },
          "annotations": {
            "summary": "Location maintenance requires inspection: access_denied",
            "description": "See docs/map/location-maintenance-runbook.md. Do not include addresses or API keys in alerts."
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "editorMode": "code",
                "expr": "max by (reason) (hashi_map_maintenance_issues{reason=\"access_denied\"})",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "$A > 0",
                "type": "math",
                "refId": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ]
        },
