<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- dev·prod: 콘솔 JSON — 도커 로그로 남아 Promtail이 수집한다. MDC(requestId·userId)가 JSON 필드로 포함된다 -->
    <springProfile name="dev | prod">
        <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
    </springProfile>

    <!-- local: 읽기 좋은 콘솔 + Loki 파이프라인 검증용 JSON 파일(logs/app.json — Promtail이 tail) -->
    <springProfile name="local">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%thread] [rid=%X{requestId:-}] [uid=%X{userId:-}] %cyan(%logger{36}) - %msg%n</pattern>
            </encoder>
        </appender>
        <appender name="FILE_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/app.json</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>logs/app.%d{yyyy-MM-dd}.json</fileNamePattern>
                <maxHistory>3</maxHistory>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE_JSON"/>
        </root>
    </springProfile>

    <!-- 그 외(test 등): 파일을 남기지 않는 기본 콘솔 -->
    <springProfile name="!dev &amp; !prod &amp; !local">
        <appender name="CONSOLE_PLAIN" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE_PLAIN"/>
        </root>
    </springProfile>
</configuration>
