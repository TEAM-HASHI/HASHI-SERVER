{
  "name": "@hashi/image-transform",
  "version": "1.0.0",
  "private": true,
  "description": "HASHI image validation and WebP rendition Lambda worker",
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "npm run clean && tsc -p tsconfig.test.json && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1119.0",
    "@aws-sdk/client-sqs": "3.1119.0",
    "ajv": "8.20.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.162",
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
