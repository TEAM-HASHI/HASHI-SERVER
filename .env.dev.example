DOCKER_USERNAME=

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

REDIS_HOST=
REDIS_PORT=6379

JWT_SECRET=

# 키 준비와 공개 활성화는 별개다. ingress·정상 트래픽 용량·후보 규모/byte 예산 검증 전 비활성화한다 (#252).
HASHI_RESTAURANT_MAP_SESSION_ENABLED=false
HASHI_RESTAURANT_MAP_SESSION_SIGNINGKEY=
# 지도 전용 Redis. 기존 REDIS_HOST/PORT(인증용)와 별도 인스턴스여야 한다.
# 로컬 격리 검증용 컨테이너: docker/docker-compose.map-redis.local.yml
HASHI_RESTAURANT_MAP_REDIS_HOST=
HASHI_RESTAURANT_MAP_REDIS_PORT=6379
HASHI_RESTAURANT_MAP_REDIS_SSL=false
HASHI_RESTAURANT_MAP_REDIS_USERNAME=
HASHI_RESTAURANT_MAP_REDIS_PASSWORD=
HASHI_RESTAURANT_MAP_REDIS_CONNECTTIMEOUT=2s
HASHI_RESTAURANT_MAP_REDIS_TIMEOUT=3s

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

AWS_REGION=
AWS_S3_BUCKET=
AWS_MEDIA_ORIGINAL_BUCKET=
AWS_MEDIA_CLEANUP_ENABLED=false
AWS_MEDIA_CLEANUP_MODE=DRY_RUN
# 정리 활성화 전 운영 환경의 업로드 만료 후 유예 시간을 명시한다.
AWS_MEDIA_CLEANUP_UPLOAD_SAFETY_WINDOW=
AWS_MEDIA_RECONCILIATION_ENABLED=false
AWS_MEDIA_RECONCILIATION_MODE=DRY_RUN
AWS_MEDIA_RECONCILIATION_ORPHAN_RETENTION=7d
CLOUDFRONT_DOMAIN=

CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGIN_PATTERNS=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=''
