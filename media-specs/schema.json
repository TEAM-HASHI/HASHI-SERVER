{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hashi.internal/media-specs/schema.json",
  "title": "HASHI media rendition specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestSchemaVersion",
    "specVersion",
    "processorRevision",
    "output",
    "purposes",
    "roles"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "manifestSchemaVersion": {
      "const": 1
    },
    "specVersion": {
      "type": "integer",
      "minimum": 1
    },
    "processorRevision": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "mimeType",
        "withoutEnlargement",
        "metadata",
        "colorSpace",
        "dimensionRounding"
      ],
      "properties": {
        "format": {
          "const": "webp"
        },
        "mimeType": {
          "const": "image/webp"
        },
        "withoutEnlargement": {
          "const": true
        },
        "metadata": {
          "const": "strip"
        },
        "colorSpace": {
          "const": "srgb"
        },
        "dimensionRounding": {
          "const": "half-up"
        }
      }
    },
    "purposes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/role"
      }
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspectRatio",
        "fit",
        "position",
        "quality",
        "defaultWidth",
        "candidates",
        "noUpscaleFallback"
      ],
      "properties": {
        "aspectRatio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "fit": {
          "enum": ["cover", "inside"]
        },
        "position": {
          "const": "centre"
        },
        "quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "defaultWidth": {
          "type": "integer",
          "minimum": 1
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dimensions"
          }
        },
        "noUpscaleFallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selection", "minimumWidth"],
          "properties": {
            "selection": {
              "enum": ["largest-croppable-width", "source-width"]
            },
            "minimumWidth": {
              "const": 1
            }
          }
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
